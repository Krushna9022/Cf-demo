COLUMN TABLE "INC_M_EMPLO" (
     "EMPID" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
     "EMPNM" NVARCHAR(100),
     "SALRY" NVARCHAR(200),
     "ISDEL" NVARCHAR(1),
     "CRTDT" DATE,
     "CRTTM" TIME,
     "CRTBY" NVARCHAR(50),
     "CHNDT" DATE,
     "CHNTM" TIME,
     "CHNBY" NVARCHAR(50)
);