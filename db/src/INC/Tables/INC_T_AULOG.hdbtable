COLUMN TABLE "INC_T_AULOG" (
    AUDID BIGINT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY ,
    REFID INTEGER ,--Reference Id
    SRVNM NVARCHAR(200) ,--Service name
    VIENM NVARCHAR(50), --	View name	
    PLOAD CLOB,--Paload 
    ISDEL	NVARCHAR (1),	--Is Deleted Flag (1=True / 0=False)
    CRTBY	NVARCHAR (60),--	Created By
    CRTDT	DATE,--	Created Date	
    CRTTM	TIME,	--Created Time	
    CHNBY	VARCHAR (60),	--Changed By	
    CHNDT	DATE,	--Changed Date	
    CHNTM	TIME	--Changed Time	
	);