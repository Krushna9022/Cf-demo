COLUMN TABLE "INC_T_EVNSM" (
    EVNID	INTEGER PRIMARY  KEY GENERATED BY DEFAULT AS IDENTITY ,	--Unique Id 
    INCID	INTEGER	,--Incident Id	
    EVDES	NVARCHAR (5000),	--Event Description	
    SECTN	NVARCHAR (50),	--Section Updated	
    PRFLW	INTEGER	,--Process Flow Id	
    ISDEL	NVARCHAR (1),	--Is Deleted Flag (1=True / 0=False)	
    CRTBY	NVARCHAR (60),	--Created By	
    CRTDT	DATE,	--Created Date	
    CRTTM	TIME,	--Created Time	
    CHNBY	NVARCHAR (60),	--Changed By	
    CHNDT	DATE,	--Changed Date	
    CHNTM	TIME	--Changed Time	
);