COLUMN TABLE "INC_T_ERLOG" (
    ERLID INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY ,
    APPNM NVARCHAR (50),--Application name
    SRVNM	NVARCHAR (50),--	Service name	
    PLOAD	CLOB,	--Payload	
    ERTXT	CLOB,--	Error text	
    MDLNM	NVARCHAR (50),--	Module name	
    CLFRM	NVARCHAR (5),--	Service function Called from UI/DB	
    ISDEL	NVARCHAR (1),--	Is Deleted Flag (1=True / 0=False)	
    CRTBY	NVARCHAR (60),--	Created By	
    CRTDT	DATE,--	Created Date	
    CRTTM	TIME--	Created Time	
);