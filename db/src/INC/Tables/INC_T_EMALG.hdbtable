COLUMN TABLE "INC_T_EMALG" (
    EMAID	INTEGER		PRIMARY  KEY GENERATED BY DEFAULT AS IDENTITY ,--Unique Id
    INCID	INTEGER	,--Incident Id	
    EMLTO	CLOB,--	Email Send To	
    EMLCC	CLOB,--	Email Send Cc	
    SUBCT	NVARCHAR (500),--	Email Subject	
    EBODY	CLOB,--	Email Body	
    ERROR	NVARCHAR (500),--	Error Text	
    SERNM	NVARCHAR (250),--	Service Name	
    ISERR	NVARCHAR (10),--	Error Status	
    ISDEL	NVARCHAR (1),--	IsDeletedFlag	
    CRTBY	NVARCHAR (60),--	Created By	
    CRTDT	DATE,--	Created Date	
    CRTTM	TIME--	Created Time	
);