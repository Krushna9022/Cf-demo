COLUMN TABLE "INC_T_CLAIM" (
    CLMID INTEGER PRIMARY KEY  GENERATED BY DEFAULT AS IDENTITY,
    CLMTP NVARCHAR(20),
    SUBTY NVARCHAR(20),
    ISDEL	NVARCHAR (1),--	IsDeletedFlag	
    CRTBY	NVARCHAR (60),--	Created By	
    CRTDT	DATE,--	Created Date	
    CRTTM	TIME,--	Created Time
    CHNBY 	NVARCHAR (60),--	Change By
    CHNDT DATE ,--change date
    CHNTM TIME 	--change time
);