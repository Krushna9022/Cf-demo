PROCEDURE "prCreateUpdateEmplo"( 
   IN EMPID BIGINT,
   IN EMPNM NVARCHAR(50),
   IN SALRY NVARCHAR(20),
   OUT OEMID BIGINT
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   -- READS SQL DATA
    AS
BEGIN
   /*************************************
       Write your procedure logic
   *************************************/
   DECLARE COLUMN_ID INTEGER;
   DECLARE QU NVARCHAR(150);
   DECLARE SEQ NVARCHAR(100);

   IF :EMPID = 0 THEN

   INSERT INTO INC_M_EMPLO 
   (EMPNM, SALRY, ISDEL, CRTDT, CRTTM, CRTBY)
   VALUES 
   (:EMPNM, :SALRY, 0, CURRENT_DATE, CURRENT_TIME, SESSION_CONTEXT('APPLICATIONUSER'));

   SELECT '"_SYS_SEQUENCE_' || COLUMN_ID || '_#0_#"' 
   INTO SEQ 
   FROM TABLE_COLUMNS 
   WHERE TABLE_NAME = 'INC_M_EMPLO' 
   AND COLUMN_NAME = 'EMPID';

   QU := 'SELECT ' || :SEQ || '.CURRVAL FROM DUMMY';

   EXECUTE IMMEDIATE :QU INTO OEMID;

ELSE

   UPDATE INC_M_EMPLO 
   SET EMPNM = :EMPNM,
       SALRY = :SALRY,
       CHNDT = CURRENT_DATE,
       CHNTM = CURRENT_TIME,
       CHNBY = SESSION_CONTEXT('APPLICATIONUSER')
   WHERE EMPID = :EMPID;

   OEMID := :EMPID;

END IF;

END;