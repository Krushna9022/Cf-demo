PROCEDURE "prCreateUpdateStudent"( 
     IN STDID        INTEGER,
    IN NAME    NVARCHAR(50),
    OUT OSID INTEGER
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
--    READS SQL DATA 
   AS
BEGIN
    DECLARE COLUMN_ID INTEGER;
 DECLARE QU NVARCHAR(150);
   DECLARE SEQ NVARCHAR(100);
    IF :STDID =0 THEN
        INSERT INTO INC_M_STUDENT (NAME)
        VALUES (NAME);

        SELECT '"_SYS_SEQUENCE_'|| COLUMN_ID||'_#0_#"' INTO SEQ FROM TABLE_COLUMNS WHERE (TABLE_NAME='INC_M_STUDENT') AND COLUMN_NAME='STDID';
 
      QU :='select '||SEQ||'.CURRVAL from DUMMY';
      EXECUTE IMMEDIATE QU INTO OSID;
    ELSE
        UPDATE  INC_M_STUDENT  SET NAME=NAME
        WHERE STDID=STDID;

        OSID:=:STDID;
    END IF;
 
END;