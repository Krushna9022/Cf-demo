PROCEDURE "prCreateUpdateDocument"( 
   IN  DOCID BIGINT, --- PRIMARY KEY,
    STDID BIGINT ,--foreign key studentid
    DOCMN NVARCHAR(255), --documentname
    DFILE NVARCHAR(255) --file attachement
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
--    READS SQL DATA 
   AS
BEGIN

    IF :DOCID =0 THEN
        INSERT INTO INC_T_DOCUMENT (STDID,DOCMN,DFILE)
        VALUES (STDID,DOCMN,DFILE);

    ELSE
        UPDATE  INC_T_DOCUMENT  SET STDID=STDID,DOCMN=DOCMN,DFILE=DFILE
        WHERE DOCID=DOCID;
    END IF;
 
END;