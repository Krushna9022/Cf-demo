PROCEDURE "prCreateUp"( 
     IN EMPID        INTEGER,
    IN FSTMN    NVARCHAR(50),
    IN LSTNM     NVARCHAR(50),
    IN DEPT   NVARCHAR(50),
    IN SALRY        DECIMAL(10,2),
    OUT EID INTEGER
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
--    READS SQL DATA 
   AS
BEGIN
    DECLARE COLUMN_ID INTEGER;
 DECLARE QU NVARCHAR(150);
   DECLARE SEQ NVARCHAR(100);
    IF :EMPID =0 THEN
        INSERT INTO INC_M_EMPLY (FIRST_NAME,LAST_NAME,DEPARTMENT,SALARY)
        VALUES (FSTMN,LSTNM,DEPT,SALRY);

        SELECT '"_SYS_SEQUENCE_'|| COLUMN_ID||'_#0_#"' INTO SEQ FROM TABLE_COLUMNS WHERE (TABLE_NAME='INC_M_EMPLY') AND COLUMN_NAME='EMP_ID';
 
      QU :='select '||SEQ||'.CURRVAL from DUMMY';
      EXECUTE IMMEDIATE QU INTO EID;
    ELSE
        UPDATE  INC_M_EMPLY  SET FIRST_NAME=FSTMN,LAST_NAME=LSTNM ,DEPARTMENT=DEPT,SALARY =SALRY
        WHERE EMP_ID=EMPID;
    END IF;
 
END;