PROCEDURE "prCreateUp"( 
     IN EMPID        INTEGER,
    IN FSTMN    NVARCHAR(50),
    IN LSTNM     NVARCHAR(50),
    IN DEPT   NVARCHAR(50),
    IN SALRY        DECIMAL(10,2)
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
--    READS SQL DATA 
   AS
BEGIN
    IF :EMPID =0 THEN
        INSERT INTO INC_M_EMPLY (FIRST_NAME,LAST_NAME,DEPARTMENT,SALARY)
        VALUES (FSTMN,LSTNM,DEPT,SALRY);
    ELSE
        UPDATE  INC_M_EMPLY  SET FIRST_NAME=FSTMN,LAST_NAME=LSTNM ,DEPARTMENT=DEPT,SALARY =SALRY
        WHERE EMP_ID=EMPID;
    END IF;
 
END;